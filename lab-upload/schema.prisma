generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
}

model Event {
  id          String    @id @default(cuid())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  name        String
  slug        String    @unique
  description String?   @db.Text
  url         String    @unique
  imageUrl    String?

  startDate   DateTime
  endDate     DateTime?

  venueName   String?
  latitude    Float?
  longitude   Float?

  price       Decimal?
  currency    String?
  isFree      Boolean   @default(false)

  tags        String[]
  
  aiSummary   String?   @db.Text
  aiFaq       Json?
  hotnessScore Int?     @default(0)

  @@map("events")
}

model MrtStation {
  id        String @id @default(cuid())
  name      String @unique
  slug      String @unique
  latitude  Float
  longitude Float

  @@map("mrt_stations")
}
